                <!-- ================================================= -->

                <div class="filters hidden" id="invReceiptForm">

                    <div class="frow">

                        <select id="irItem" class="fsel"></select>

                        <input id="irQty" type="number" min="0.001" placeholder="مقدار" style="width:110px" />

                        <input id="irLot" placeholder="شماره بچ/لات" />

                        <select id="irWarehouse" class="fsel"></select>

                        <input id="irLocation" placeholder="محل/قفسه" />

                        <select id="irStatus" class="fsel">

                            <option value="available">
                                قابل مصرف
                            </option>

                            <option value="quarantine">
                                قرنطینه
                            </option>

                            <option value="rejected">
                                مردود
                            </option>

                        </select>


                        <select id="irType" class="fsel">

                            <option value="purchase">
                                خرید
                            </option>

                            <option value="production">
                                تولید
                            </option>

                            <option value="return">
                                برگشت
                            </option>

                            <option value="opening">
                                موجودی افتتاحیه
                            </option>

                        </select>

                    </div>


                    <div class="frow" style="margin-top:8px">

                        <input id="irSupplier" placeholder="تأمین‌کننده / مبدأ" />

