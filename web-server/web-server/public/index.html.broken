                        </button>

                        <button class="act excel" id="expInventoryTx">
                            خروجی گردش 📊
                        </button>

                    </span>
                </h2>


                <p class="note">
                    دفتر کل انبار بر مبنای رسید، حواله، انتقال و اصلاح موجودی محاسبه می‌شود؛
                    موجودی منفی از سمت سرور مسدود است.
                </p>


                <!-- ================================================= -->
                <!-- ITEM MASTER -->
                <!-- ================================================= -->

                <div class="filters hidden" id="invItemForm">

                    <div class="frow">

                        <input id="invItemCode" placeholder="کد کالا — مثال: DR-220L" />

                        <input id="invItemName" placeholder="نام کالا" />

                        <input id="invItemCategory" placeholder="دسته — مواد اولیه / محصول / قطعات" />

                        <input id="invItemUnit" placeholder="واحد — عدد / kg / متر" style="width:120px" />

                        <input id="invItemROP" type="number" min="0" placeholder="نقطه سفارش" style="width:120px" />

                        <input id="invItemMin" type="number" min="0" placeholder="حداقل موجودی" style="width:120px" />

                        <input id="invItemMax" type="number" min="0" placeholder="حداکثر موجودی" style="width:120px" />

                        <label class="flbl">
                            <input id="invItemBatch" type="checkbox" />
                            رهگیری بچ/لات
                        </label>

                    </div>


                    <div class="frow" style="margin-top:8px">

                        <input id="invItemDesc" placeholder="توضیحات" style="flex:1 1 300px" />

                        <button class="act" id="invItemSave" data-save style="background:#15803d">
