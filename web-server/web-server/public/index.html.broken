                    <div class="frow">

                        <select id="iaItem" class="fsel"></select>

                        <input id="iaDelta" type="number" step="0.001" placeholder="اصلاح + / -" style="width:120px" />

                        <input id="iaLot" placeholder="شماره بچ/لات" />

                        <select id="iaWarehouse" class="fsel"></select>

                        <input id="iaLocation" placeholder="محل/قفسه" />

                        <select id="iaStatus" class="fsel">

                            <option value="available">
