                            <option value="0">بازرسی درز: معیوب</option>
                        </select>
                        <input type="text" id="fqDesc" placeholder="توضیحات (اختیاری)" style="flex:1 1 220px" />
                        <button class="act" id="fqSave" style="background:#15803d">ذخیره</button>
                        <button class="act fclear" id="fqCancel">انصراف</button>
                    </div>
                    <div class="note" id="fqMsg" style="color:#dc2626"></div>
