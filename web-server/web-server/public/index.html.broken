<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>سامانه یکپارچه Sanatify MES — پنل گزارش‌گیری</title>
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js">
    </script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        body {
            font-family: Vazirmatn, Tahoma, "Segoe UI", Arial, sans-serif;
            background: #f1f5f9;
            color: #0f172a;
            direction: rtl;
            line-height: 1.7
        }

        header {
            background: #1e3d59;
            color: #fff;
            padding: 14px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px
        }

        header h1 {
            font-size: 18px
        }

        .livebar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap
        }

        .dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: #94a3b8;
            display: inline-block;
            transition: background .3s
        }

        .dot.ok {
            background: #34d399;
            box-shadow: 0 0 7px #34d399
        }

        .dot.err {
            background: #f87171;
            box-shadow: 0 0 7px #f87171
        }

        .liveago {
            font-size: 12px;
            opacity: .9;
            min-width: 120px;
            text-align: left
        }

        .livebtn {
            background: rgba(255, 255, 255, .14);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, .3);
            padding: 5px 11px;
            border-radius: 8px;
            cursor: pointer;
            font-family: inherit;
            font-size: 12px;
            font-weight: bold
        }

        .livebtn.off {
            background: rgba(248, 113, 113, .25);
            border-color: rgba(248, 113, 113, .5)
        }

        nav {
            background: #fff;
            padding: 10px 16px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            border-bottom: 1px solid #e2e8f0;
            position: sticky;
            top: 0;
            z-index: 5
        }

        nav button {
            border: 1px solid #cbd5e1;
            background: #f8fafc;
            color: #1e3d59;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            font-family: inherit;
            font-size: 13px;
            font-weight: bold
        }

        nav button.active {
            background: #1e3d59;
            color: #fff;
            border-color: #1e3d59
        }

        main {
            max-width: 1180px;
            margin: 0 auto;
            padding: 20px 16px 60px
        }

        .sumbar {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 14px
        }

        .kpis {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 12px;
            margin-bottom: 20px
        }

        .kpi {
            background: #fff;
            border-radius: 12px;
            padding: 14px;
            border-top: 4px solid #1e3d59;
            box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
            text-align: center
        }

        .kpi .v {
            font-size: 22px;
            font-weight: bold;
            color: #1e3d59
        }

        .kpi .l {
            font-size: 12px;
            color: #64748b;
            margin-top: 4px
        }

        .kpi.green {
            border-top-color: #059669
        }

        .kpi.green .v {
            color: #059669
        }

        .kpi.red {
            border-top-color: #dc2626
        }

        .kpi.red .v {
            color: #dc2626
        }

        .kpi.amber {
            border-top-color: #d97706
        }

        .kpi.amber .v {
            color: #d97706
        }

        .panel {
            background: #fff;
            border-radius: 12px;
            padding: 18px;
            box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
            margin-bottom: 18px
        }

        .panel h2 {
            font-size: 16px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px
        }

        .toolbar {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center
        }

        input[type=text] {
            padding: 8px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-family: inherit;
            font-size: 13px;
            min-width: 220px;
            text-align: right
        }

        button.act {
            background: #1e3d59;
            color: #fff;
            border: none;
            padding: 9px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-family: inherit;
            font-weight: bold;
            font-size: 13px
        }

        button.excel {
            background: #15803d
        }

        button.act:disabled {
            opacity: .5;
            cursor: not-allowed
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px
        }

        th,
        td {
            padding: 9px 10px;
            text-align: right;
            border-bottom: 1px solid #eef2f7
        }

        th {
            background: #f8fafc;
            color: #475569;
            font-weight: bold;
            position: sticky;
            top: 0;
            user-select: none
        }

        th[data-sort]:hover {
            background: #eef2f7
        }

        tr:hover td {
            background: #fafcff
        }

        .chip {
            display: inline-block;
            padding: 2px 9px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold
        }

        .chip.ok {
            background: rgba(52, 211, 153, .16);
            color: #059669
        }

        .chip.no {
            background: rgba(248, 113, 113, .16);
            color: #dc2626
        }

        .chip.wait {
            background: rgba(251, 191, 36, .16);
            color: #d97706
        }

        .empty {
            color: #64748b;
            text-align: center;
            padding: 24px
        }

        .hidden {
            display: none
        }

        .note {
            font-size: 11px;
            color: #94a3b8;
            margin-top: 10px
        }

        .tablewrap {
            overflow-x: auto
        }

        .filters {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 10px;
            margin-bottom: 12px
        }

        .frow {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center
        }

        .fsearch {
            flex: 1 1 200px;
            min-width: 160px
        }

        .fsel,
        .fdate {
            padding: 8px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-family: inherit;
            font-size: 12px;
            background: #fff
        }

        .flbl {
            font-size: 12px;
            color: #475569;
            display: inline-flex;
            align-items: center;
            gap: 5px
        }

        .fclear {
            background: #64748b;
            padding: 8px 12px;
            font-size: 12px
        }

        .pager {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 12px;
            padding-top: 10px;
            border-top: 1px solid #eef2f7
        }

        .pinfo {
            font-size: 12px;
            color: #64748b
        }

        .pbtns {
            display: flex;
            align-items: center;
            gap: 8px
        }

        .pbtns button {
            padding: 6px 12px;
            font-size: 12px
        }

        .ppage {
            font-size: 12px;
            color: #334155;
            font-weight: bold
        }

        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 16px
        }

        .chart-card {
            background: #fff;
            border-radius: 12px;
            padding: 16px;
            box-shadow: 0 1px 3px rgba(0, 0, 0, .08)
        }

        .chart-card h3 {
            font-size: 14px;
            margin-bottom: 14px;
            color: #1e3d59;
            font-weight: bold
        }

        .chart-container {
            position: relative;
            height: 280px
        }

        .userbar {
            display: flex;
            align-items: center;
            gap: 10px
        }

        .userbar .uname {
            font-size: 12px;
            color: #fff;
            opacity: .9
        }

        .userbar .ulogout {
            background: rgba(255, 255, 255, .14);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, .3);
            padding: 5px 11px;
            border-radius: 8px;
            cursor: pointer;
            font-family: inherit;
            font-size: 12px;
            font-weight: bold
        }

        .filter-panel {
            background: linear-gradient(135deg, #1e3d59 0%, #2d5a87 100%);
            color: #fff;
            padding: 16px;
            border-radius: 12px;
            margin-bottom: 18px
        }

        .filter-panel label {
            color: #fff;
            font-size: 12px;
            margin-left: 6px
        }

        .filter-panel input,
        .filter-panel select {
            padding: 6px 10px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            font-family: inherit;
            font-size: 12px
        }

        .filter-panel input::placeholder {
            color: rgba(255, 255, 255, .6)
        }

        .filter-panel button {
            background: #fbbf24;
            color: #1e3d59;
            border: none;
            padding: 7px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            font-size: 12px
        }

        /* =========================================================
   INDUSTRIALFY — Maintenance / PM UI
   ========================================================= */

        .maintenance-panel {
            border-top: 4px solid #1e3d59;
        }

        .mnt-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .mnt-header h2 {
            margin-bottom: 2px;
        }

        .mnt-subtitle {
            color: #64748b;
            font-size: 11px;
        }

        .mnt-form {
            border: 1px solid #dbe5ef;
            background: linear-gradient(180deg,
                    #f8fafc 0%,
                    #f1f5f9 100%);
        }

        .mnt-form-title {
            color: #1e3d59;
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 10px;
            padding-bottom: 8px;
            border-bottom: 1px solid #e2e8f0;
        }

        .mnt-kpis {
            margin-top: 16px;
        }

        .mnt-section-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 22px 0 8px;
            padding: 10px 12px;
            border-right: 4px solid #1e3d59;
            background: #f8fafc;
            border-radius: 8px;
        }

        .mnt-section-head h3 {
            font-size: 14px;
            color: #1e3d59;
            margin: 0;
        }

        .mnt-section-head span {
            display: block;
            color: #94a3b8;
            font-size: 10px;
            margin-top: 2px;
        }

        .mnt-reasons {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 14px;
        }

        .mnt-reason-row {
            margin-bottom: 12px;
        }

        .mnt-reason-row:last-child {
            margin-bottom: 0;
        }

        .mnt-reason-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            font-size: 12px;
            margin-bottom: 5px;
        }

        .mnt-reason-head strong {
            color: #475569;
            white-space: nowrap;
        }

        .mnt-reason-track {
            height: 12px;
            background: #eef2f7;
            border-radius: 8px;
            overflow: hidden;
        }

        .mnt-reason-track>div {
            height: 100%;
            background: linear-gradient(90deg,
                    #dc2626,
                    #f97316);
            border-radius: 8px;
            transition: width .35s ease;
        }

        #tbl-pmplans td,
        #tbl-mntlogs td,
        #tbl-maintenance td {
            vertical-align: middle;
        }

        #tbl-pmplans tr:hover td,
        #tbl-mntlogs tr:hover td,
        #tbl-maintenance tr:hover td {
            background: #f8fbff;
        }

        @media (max-width: 760px) {

            .mnt-header {
                flex-direction: column;
            }

            .mnt-header .toolbar {
                width: 100%;
            }

            .mnt-header .toolbar>* {
                flex: 1 1 160px;
            }

            .mnt-reason-head {
                align-items: flex-start;
                flex-direction: column;
                gap: 3px;
            }
        }

        /* =========================================================
   INDUSTRIAL FAY — INVENTORY UI
   ========================================================= */

        .inv-subtitle {

            margin: 18px 0 8px;

            padding: 10px 14px;

            background: #f8fafc;

            border-right:
                4px solid #1e3d59;

            border-radius: 8px;

            color: #1e3d59;

            font-size: 14px;
        }


        #tab-warehouse .panel {

            border-top:
                4px solid #1e3d59;
        }


        #tab-warehouse .toolbar {

            max-width: 100%;

            justify-content:
                flex-start;
        }


        #tab-warehouse .filters {

            margin-top: 10px;
        }


        #tab-warehouse input[type=number] {

            padding: 8px 10px;

            border:
                1px solid #cbd5e1;

            border-radius: 8px;

            font-family: inherit;

            font-size: 12px;
        }


        #tab-warehouse input[type=checkbox] {

            accent-color:
                #1e3d59;
        }


        #tab-warehouse .kpi {

            min-height: 82px;
        }
    </style>
</head>

<body>
    <header>
        <h1>🏭 سامانه یکپارچه Sanatify MES — پنل گزارش‌گیری و ردیابی</h1>
        <div class="userbar" id="userbar"></div>
        <div class="livebar">
            <span class="dot" id="liveDot" title="وضعیت اتصال زنده"></span>
            <span class="liveago" id="liveAgo">در حال اتصال...</span>
            <button class="livebtn" id="liveToggle">بروزرسانی خودکار: روشن</button>
        </div>
    </header>
    <nav id="nav">
        <button data-tab="summary" class="active">خلاصه و شاخص‌ها</button>
        <button data-tab="analytics">داشبورد تحلیلی</button>
        <button data-tab="production">ثبت تولید</button>
        <button data-tab="waste">ضایعات</button>
        <button data-tab="downtime">توقفات</button>
        <button data-tab="quality">کنترل کیفیت</button>
        <button data-tab="genealogy">ردیابی بچ تولید</button>
        <button data-tab="balance">بالانس ورق</button>
        <button data-tab="maintenance">تعمیرات و PM</button>
        <button data-tab="warehouse">انبار و موجودی</button>
    </nav>
    <main>
        <div class="filter-panel" id="filterPanel" style="display:none">
            <div class="frow">
                <label>از تاریخ (شمسی): <input type="text" inputmode="numeric" data-jp="pf" id="filterFrom"
                        placeholder="۱۴۰۵/۰۵/۰۱" style="width:110px;text-align:center"></label>
                <label>تا تاریخ (شمسی): <input type="text" inputmode="numeric" data-jp="pt" id="filterTo"
                        placeholder="۱۴۰۵/۰۵/۶" style="width:110px;text-align:center"></label>
                <label>شیفت: <select id="filterShift">
                        <option value="all">همه</option>
                        <option value="shift-morning-301">صبح</option>
                        <option value="shift-night-302">شب</option>
                    </select></label>
                <label>محصول: <select id="filterProduct">
                        <option value="all">همه</option>
                        <option value="DR-220L">بشکه ۲۲۰ لیتری</option>
                        <option value="DR-120L">بشکه ۱۲۰ لیتری</option>
                    </select></label>
                <button id="applyFilter">🔍 اعمال فیلتر</button>
                <button id="clearFilter">✖ پاک کردن</button>
            </div>
        </div>
        <section id="tab-summary">
            <div class="sumbar"><button class="act excel" id="expSummary">خروجی اکسل خلاصه 📊</button></div>
            <div class="kpis" id="kpiBox"></div>
        </section>
        <section id="tab-analytics" class="hidden">
            <div class="analytics-grid">
                <div class="chart-card">
                    <h3>📉 توزیع علل توقف</h3>
                    <div class="chart-container"><canvas id="chart-downtime"></canvas></div>
                </div>
                <div class="chart-card">
                    <h3>🗑️ توزیع علل ضایعات</h3>
                    <div class="chart-container"><canvas id="chart-waste"></canvas></div>
                </div>
                <div class="chart-card">
                    <h3>🏭 تولید بر اساس شیفت</h3>
                    <div class="chart-container"><canvas id="chart-shift"></canvas></div>
                </div>
                <div class="chart-card">
                    <h3>📅 روند تولید روزانه</h3>
                    <div class="chart-container"><canvas id="chart-daily"></canvas></div>
                </div>
            </div>
            <p class="note">نمودارها بر اساس فیلترهای انتخابی ساخته می‌شوند و هر ۱۵ ثانیه تازه می‌شوند.</p>
        </section>
        <section id="tab-production" class="hidden">
            <div class="panel">
                <h2>ثبت تولید سالم <span class="toolbar"><button class="act" id="btnAddProduction"
                            style="display:none">➕ ثبت تولید جدید</button><button class="act excel"
                            data-exp="production">خروجی اکسل 📊</button></span></h2>
                <div class="filters hidden" id="formProduction">
                    <div class="frow">
                        <span class="flbl" id="fpBy" style="font-weight:bold">ثبت‌کننده: -</span>
                        <select id="fpProduct" class="fsel">
                            <option value="DR-220L">بشکه ۲۲۰ لیتری</option>
                            <option value="DR-120L">بشکه ۱۲۰ لیتری</option>
                        </select>
                        <select id="fpShift" class="fsel">
                            <option value="shift-morning-301">شیفت صبح</option>
                            <option value="shift-night-302">شیفت شب</option>
                        </select>
                        <input type="number" id="fpQty" min="1" placeholder="تعداد سالم" style="width:110px" />
                        <input type="number" id="fpPallets" min="0" placeholder="تعداد پالت (اختیاری)"
                            style="width:160px" />
                    </div>
                    <div class="frow" style="margin-top:8px">
                        <span class="flbl">ایستگاه نهایی: <b>تست و بسته‌بندی (دروازهٔ پایان خط)</b></span>
                        <input type="text" id="fpDesc" placeholder="توضیحات (اختیاری)" style="flex:1 1 260px" />
                        <button class="act" id="fpSave" style="background:#15803d">ذخیره</button>
                        <button class="act fclear" id="fpCancel">انصراف</button>
                    </div>
                    <div class="note" id="fpMsg" style="color:#dc2626"></div>
                </div>
                <div class="filters" id="filter-production"></div>
                <div class="tablewrap">
                    <table id="tbl-production"></table>
                </div>
                <div class="pager" id="pager-production"></div>
            </div>
        </section>
        <section id="tab-waste" class="hidden">
            <div class="panel">
                <h2>ضایعات و پرت خط <span class="toolbar"><button class="act" id="btnAddWaste" style="display:none">➕
                            ثبت ضایعات جدید</button><button class="act excel" data-exp="waste">خروجی اکسل
                            📊</button></span></h2>
                <div class="filters hidden" id="formWaste">
                    <div class="frow">
                        <select id="fwStation" class="fsel"></select>
                        <select id="fwType" class="fsel">
                            <option value="sheet">ورق</option>
                            <option value="body">بدنه</option>
                            <option value="ends">درب/ته</option>
                            <option value="full">بشکهٔ کامل</option>
                        </select>
                        <select id="fwReason" class="fsel">
                            <option value="leak-failed">نشت در تست فشار</option>
                            <option value="deformed-body">دفرمگی بدنه</option>
                            <option value="scratch-lining">خراش لاینینگ</option>
                            <option value="weld-defect">عیب جوش درز</option>
                            <option value="crop-ends">کراپ دو سر</option>
                            <option value="other">سایر</option>
                        </select>
                        <input type="number" id="fwQty" min="1" placeholder="تعداد" style="width:90px" />
                        <select id="fwShift" class="fsel">
                            <option value="shift-morning-301">شیفت صبح</option>
                            <option value="shift-night-302">شیفت شب</option>
                        </select>
                    </div>
                    <div class="frow" style="margin-top:8px">
                        <input type="text" id="fwDesc" placeholder="توضیحات (اختیاری)" style="flex:1 1 260px" />
                        <button class="act" id="fwSave" style="background:#15803d">ذخیره</button>
                        <button class="act fclear" id="fwCancel">انصراف</button>
                    </div>
                    <div class="note" id="fwMsg" style="color:#dc2626"></div>
                </div>
                <div class="filters" id="filter-waste"></div>
                <div class="tablewrap">
                    <table id="tbl-waste"></table>
                </div>
                <div class="pager" id="pager-waste"></div>
            </div>
        </section>
        <section id="tab-downtime" class="hidden">
            <div class="panel">
                <h2>توقفات خط <span class="toolbar"><button class="act" id="btnAddDowntime" style="display:none">➕ ثبت
                            توقف جدید</button><button class="act excel" data-exp="downtime">خروجی اکسل
                            📊</button></span></h2>
                <div class="filters hidden" id="formDowntime">
                    <div class="frow">
                        <select id="fdStation" class="fsel"></select>
                        <select id="fdReason" class="fsel">
                            <option value="seam-wheel-change">تعویض چرخ درزبند</option>
                            <option value="coil-feed-jam">گیرش ورق در فیدر</option>
                            <option value="forming-adjust">تنظیم دستگاه فرمینگ</option>
                            <option value="paint-booth-cleaning">تمیزکاری اتاق رنگ</option>
                            <option value="mech_elec">خرابی مکانیکی / برقی</option>
                            <option value="electrical">خرابی برقی</option>
                            <option value="hydraulic">خرابی هیدرولیک</option>
                            <option value="other">سایر</option>
                        </select>
                        <select id="fdType" class="fsel">
                            <option value="1">اضطراری</option>
                            <option value="0">برنامه‌ریزی</option>
                        </select>
                        <select id="fdShift" class="fsel">
                            <option value="shift-morning-301">شیفت صبح</option>
                            <option value="shift-night-302">شیفت شب</option>
