                            </option>

                            <option value="quarantine">
                                قرنطینه
                            </option>

                        </select>

                        <input id="iaReason" placeholder="علت اصلاح — شمارش دوره‌ای / کسری / اضافه" />

                    </div>


                    <div class="frow" style="margin-top:8px">

                        <input id="iaDesc" placeholder="شرح" style="flex:1 1 300px" />

                        <button class="act" id="invAdjustSave" data-save style="background:#15803d">
