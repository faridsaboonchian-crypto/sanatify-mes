                        </button>

                        <button class="act fclear"
                            onclick="document.getElementById('invItemForm').classList.add('hidden')">
                            انصراف
                        </button>

                    </div>

                    <div class="note" id="invItemMsg"></div>

                </div>


                <!-- ================================================= -->
